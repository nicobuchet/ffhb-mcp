{
  "name": "@nicobuchet/ffhb-mcp",
  "version": "0.1.0",
  "description": "MCP server for indexing and exposing data from the FFHandball website.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobuchet/ffhb-mcp.git"
  },
  "homepage": "https://github.com/nicobuchet/ffhb-mcp#readme",
  "bugs": {
    "url": "https://github.com/nicobuchet/ffhb-mcp/issues"
  },
  "type": "module",
  "files": [
    "dist/src"
  ],
  "bin": {
