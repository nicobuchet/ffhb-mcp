{
  "name": "ffhb-mcp",
  "version": "0.1.0",
  "description": "MCP server for indexing and exposing data from the FFHandball website.",
  "type": "module",
  "bin": {
    "ffhb-mcp": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cheerio": "^1.2.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
